# Options for unfsd (see unfsd(8)).
#   -t        TCP only
#   -N auto   correct hard link counts on CIFS/SMB3 exports (default)
#   -H N      file handle cache entries (about 130 MB per million)
#   -L        also cache names from directory listings
#   -e FILE   exports file
UNFSD_OPTS="-t -N auto -H 1000000 -L -e /etc/exports.unfsd"
